# Hosted installation only. The desktop launcher always selects the local fictional demo.
CONVERGE_MODE=production
CONVERGE_ORIGIN=https://trips.example.org
NEXTAUTH_URL=https://trips.example.org
PORT=5075
# CONVERGE_BIND_ADDRESS=0.0.0.0
CONVERGE_NAMESPACE=trips.example.org
CONVERGE_OPERATOR=Your trip group
CONVERGE_CONTACT=operator@example.org
GOOGLE_CLIENT_ID=replace-with-your-own-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-own-client-secret
NEXTAUTH_SECRET=replace-with-a-new-random-value-at-least-32-characters
ACTOR_KEY_SECRET=replace-with-a-different-stable-random-value-at-least-32-characters
CRON_SECRET=replace-with-a-third-random-value
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-own-server-only-key
# Owner setup only, not required by the running app. Use direct or session pooler.
DATABASE_URL=postgresql://your-user:your-password@your-database.example.org:5432/postgres
# CONVERGE_DATABASE_CA_CERT=/path/to/your/provider-ca.pem
# Optional email, disabled until configured. No invitation emails are sent automatically.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=no
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# CONVERGE_MAIL_FROM=Your trip group <trips@example.org>
# Optional AI, disabled by default.
CONVERGE_ENABLE_AI=no
# GEMINI_API_KEY=your-own-api-key
AI_DAILY_BUDGET_USD=1
